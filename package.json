{
  "name": "chariot-racing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && uv run pytest",
    "lint:py": "uv run ruff check tests scripts && uv run ruff format --check tests scripts",
    "test": "npm run test:unit && npm run lint:py && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
